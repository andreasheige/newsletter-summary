# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Server
PORT=3000

# How often to check email (cron expression) - default: every 6 hours
CRON_SCHEDULE=0 */6 * * *

# Filter: only process emails matching these senders (comma-separated, optional)
# NEWSLETTER_SENDERS=newsletter@example.com,updates@company.com
NEWSLETTER_SENDERS=hello.evolvingai@gmail.com, dan@tldrnewsletter.com, news@alphasignal.ai, yo@dev.to, newsletters-noreply@linkedin.com

# How far back to look for emails (in days, default: 90)
LOOKBACK_DAYS=365

# Mark emails as read in Mail.app after processing (set to "true" to enable)
MARK_AS_READ=false